# Normalize maintained source and docs across platforms.
* text=auto eol=lf

# Preserve historical evidence byte-for-byte, including CRLF CSV exports.
reports/** -text

# Preserve generated CSV evidence and archived paper snapshots with their hashes.
paper/**/*.csv -text -whitespace
# Matplotlib SVG path lines legitimately retain trailing spaces.
paper/figures/*.svg -whitespace

# Binary media and archives.
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.zip binary
